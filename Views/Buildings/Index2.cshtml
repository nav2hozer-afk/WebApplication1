@model List<WebApplication1.Models.Material>

<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #8e44ad 0%, #e74c3c 100%);
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }

        h2 {
            color: #8e44ad;
            border-left: 5px solid #e74c3c;
            padding-left: 15px;
            text-align: center;
            border-left: none;
        }

        .nav-links {
            text-align: center;
            padding: 15px;
            background: #f0f0f0;
            border-radius: 10px;
            margin-bottom: 20px;
        }

            .nav-links a {
                margin: 0 15px;
                text-decoration: none;
                color: #8e44ad;
                font-weight: bold;
            }

        form {
            background: #f9f9f9;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            max-width: 400px;
            margin-left: auto;
            margin-right: auto;
            text-align: center;
        }

        label {
            font-weight: bold;
            display: block;
            margin-top: 10px;
            margin-bottom: 5px;
            text-align: left;
        }

        input, select {
            padding: 8px;
            margin: 5px 0;
            border: 1px solid #ddd;
            border-radius: 5px;
            width: 100%;
        }

        button {
            background: linear-gradient(135deg, #8e44ad 0%, #e74c3c 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 15px;
            display: inline-block;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }

        th {
            background: #8e44ad;
            color: white;
        }

        .delete-btn {
            background: #e74c3c;
            padding: 5px 10px;
            font-size: 12px;
        }

        .low-stock {
            background-color: #ffeaa7;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>📦 Склад строительных материалов</h1>

        <div class="nav-links">
            <a href="/Buildings/Index">🏠 Здания</a>
            <a href="/Buildings/Index1">👷 Рабочие</a>
            <a href="/Buildings/Index2">📦 Материалы</a>
        </div>

        <h2>➕ Добавить новый материал</h2>
        <form asp-action="AddMaterial" method="post">
            <label>Название:</label>
            <input type="text" name="Name" required />
            <br />
            <label>Тип:</label>
            <select name="Type">
                <option value="Строительный">Строительный</option>
                <option value="Отделочный">Отделочный</option>
                <option value="Инструмент">Инструмент</option>
            </select>
            <br />
            <label>Количество:</label>
            <input type="number" name="Quantity" required />
            <br />
            <label>Цена (₽):</label>
            <input type="number" name="Price" required />
            <br />
            <button type="submit">📦 Добавить материал</button>
        </form>

        <h2>📋 Список материалов</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Тип</th>
                    <th>Количество</th>
                    <th>Цена</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var material in Model)
                {
                    <tr class="@(material.Quantity < 50 ? "low-stock" : "")">
                        <td>@material.Id</td>
                        <td>@material.Name</td>
                        <td>@material.Type</td>
                        <td>@material.Quantity @(material.Type == "Инструмент" ? "шт" : "ед")</td>
                        <td>@material.Price ₽</td>
                        <td>
                            <form asp-action="DeleteMaterial" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@material.Id" />
                                <button type="submit" class="delete-btn" onclick="return confirm('Удалить материал?')">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="margin-top: 20px; text-align: center;">
            <small>* Желтым выделены материалы с количеством менее 50</small>
        </div>
    </div>
</body>
</html>